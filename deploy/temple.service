# /etc/systemd/system/temple.service
[Unit]
Description=The Temple of Records
After=network.target

[Service]
User=temple
Group=temple
WorkingDirectory=/opt/temple-of-records
ExecStart=/usr/bin/node server/server.js
Environment=TOR_HTTPS=1
Environment=TOR_TRUST_PROXY=1
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Code root stays read-only; runtime data, media uploads, SEO, and flags live in data dir / flags.json
ReadWritePaths=/opt/temple-of-records/server/data /opt/temple-of-records/server/flags.json

[Install]
WantedBy=multi-user.target
